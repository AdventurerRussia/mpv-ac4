diff --git a/libavcodec/nvjpeg2k_loader.h b/libavcodec/nvjpeg2k_loader.h
new file mode 100644
index 0000000..cfd6520
--- /dev/null
+++ b/libavcodec/nvjpeg2k_loader.h
@@ -0,0 +1,219 @@
+/*
+ * nvJPEG2000 dynamic loader header
+ * Hand-crafted from DLL exports + NVIDIA nvJPEG2000 SDK documentation.
+ * No compile-time dependency on nvJPEG2000 SDK or CUDA toolkit required.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_NVJPEG2K_LOADER_H
+#define AVCODEC_NVJPEG2K_LOADER_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+/* ------------------------------------------------------------------ */
+/* Opaque handle types (forward-declared as incomplete structs)        */
+/* ------------------------------------------------------------------ */
+
+typedef struct nvjpeg2kHandle         *nvjpeg2kHandle_t;
+typedef struct nvjpeg2kDecodeState    *nvjpeg2kDecodeState_t;
+typedef struct nvjpeg2kStream         *nvjpeg2kStream_t;
+typedef struct nvjpeg2kDecodeParams   *nvjpeg2kDecodeParams_t;
+
+/* ------------------------------------------------------------------ */
+/* CUDA opaque types we need for cuMemcpyDtoH (from nvcuda.dll)       */
+/* ------------------------------------------------------------------ */
+
+typedef unsigned long long CUdeviceptr;
+typedef int                CUresult;
+#define CUDA_SUCCESS 0
+
+/* ------------------------------------------------------------------ */
+/* nvJPEG2000 status enum                                              */
+/* ------------------------------------------------------------------ */
+
+typedef enum {
+    NVJPEG2K_STATUS_SUCCESS           = 0,
+    NVJPEG2K_STATUS_NOT_INITIALIZED   = 1,
+    NVJPEG2K_STATUS_INVALID_PARAMETER = 2,
+    NVJPEG2K_STATUS_BAD_JPEG         = 3,
+    NVJPEG2K_STATUS_JPEG_NOT_SUPPORTED = 4,
+    NVJPEG2K_STATUS_ALLOCATOR_FAILURE = 5,
+    NVJPEG2K_STATUS_EXECUTION_FAILED  = 6,
+    NVJPEG2K_STATUS_ARCH_MISMATCH     = 7,
+    NVJPEG2K_STATUS_INTERNAL_ERROR    = 8,
+    NVJPEG2K_STATUS_IMPLEMENTATION_NOT_SUPPORTED = 9,
+} nvjpeg2kStatus_t;
+
+/* ------------------------------------------------------------------ */
+/* nvJPEG2000 pixel type enum                                          */
+/* ------------------------------------------------------------------ */
+
+typedef enum {
+    NVJPEG2K_UINT8  = 0,  /* 8-bit unsigned  */
+    NVJPEG2K_UINT16 = 1,  /* 16-bit unsigned */
+    NVJPEG2K_INT16  = 2,  /* 16-bit signed   */
+} nvjpeg2kImageType_t;
+
+/* ------------------------------------------------------------------ */
+/* nvJPEG2000 image info structs                                       */
+/* ------------------------------------------------------------------ */
+
+/* Per-component info returned by nvjpeg2kStreamGetImageComponentInfo */
+typedef struct {
+    uint32_t component_width;   /* width of this component  */
+    uint32_t component_height;  /* height of this component */
+    uint8_t  precision;         /* bit-depth (e.g. 12)      */
+    uint8_t  sgn;               /* 0=unsigned, 1=signed     */
+} nvjpeg2kImageComponentInfo_t;
+
+/* Global image info returned by nvjpeg2kStreamGetImageInfo */
+typedef struct {
+    uint32_t image_width;       /* full image width  */
+    uint32_t image_height;      /* full image height */
+    uint32_t tile_width;        /* tile width  */
+    uint32_t tile_height;       /* tile height */
+    uint32_t num_tiles_x;       /* number of tiles in X */
+    uint32_t num_tiles_y;       /* number of tiles in Y */
+    uint32_t num_components;    /* number of colour components */
+} nvjpeg2kImageInfo_t;
+
+/* Decoded image descriptor (device or host pointers per component) */
+typedef struct {
+    void               **pixel_data;     /* array[num_components] of pointers */
+    size_t              *pitch_in_bytes; /* array[num_components] of pitches  */
+    nvjpeg2kImageType_t  pixel_type;     /* data type stored                  */
+    uint32_t             num_components;
+} nvjpeg2kImage_t;
+
+/* ------------------------------------------------------------------ */
+/* Function pointer typedefs                                           */
+/* ------------------------------------------------------------------ */
+
+/* nvjpeg2kCreateSimple(nvjpeg2kHandle_t *handle) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kCreateSimple)(nvjpeg2kHandle_t *handle);
+
+/* nvjpeg2kDestroy(nvjpeg2kHandle_t handle) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kDestroy)(nvjpeg2kHandle_t handle);
+
+/* nvjpeg2kDecodeStateCreate(nvjpeg2kHandle_t handle,
+                              nvjpeg2kDecodeState_t *decode_state) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kDecodeStateCreate)(
+    nvjpeg2kHandle_t handle, nvjpeg2kDecodeState_t *decode_state);
+
+/* nvjpeg2kDecodeStateDestroy(nvjpeg2kDecodeState_t decode_state) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kDecodeStateDestroy)(
+    nvjpeg2kDecodeState_t decode_state);
+
+/* nvjpeg2kStreamCreate(nvjpeg2kStream_t *stream) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kStreamCreate)(nvjpeg2kStream_t *stream);
+
+/* nvjpeg2kStreamDestroy(nvjpeg2kStream_t stream) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kStreamDestroy)(nvjpeg2kStream_t stream);
+
+/* nvjpeg2kStreamParse(nvjpeg2kHandle_t handle,
+                        const unsigned char *data, size_t length,
+                        int save_metadata, int save_stream,
+                        nvjpeg2kStream_t stream) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kStreamParse)(
+    nvjpeg2kHandle_t handle,
+    const unsigned char *data, size_t length,
+    int save_metadata, int save_stream,
+    nvjpeg2kStream_t stream);
+
+/* nvjpeg2kStreamGetImageInfo(nvjpeg2kStream_t stream,
+                               nvjpeg2kImageInfo_t *image_info) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kStreamGetImageInfo)(
+    nvjpeg2kStream_t stream, nvjpeg2kImageInfo_t *image_info);
+
+/* nvjpeg2kStreamGetImageComponentInfo(nvjpeg2kStream_t stream,
+                                        nvjpeg2kImageComponentInfo_t *comp_info,
+                                        uint32_t component_id) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kStreamGetImageComponentInfo)(
+    nvjpeg2kStream_t stream,
+    nvjpeg2kImageComponentInfo_t *comp_info,
+    uint32_t component_id);
+
+/* nvjpeg2kDecodeParamsCreate(nvjpeg2kDecodeParams_t *decode_params) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kDecodeParamsCreate)(
+    nvjpeg2kDecodeParams_t *decode_params);
+
+/* nvjpeg2kDecodeParamsDestroy(nvjpeg2kDecodeParams_t decode_params) */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kDecodeParamsDestroy)(
+    nvjpeg2kDecodeParams_t decode_params);
+
+/* nvjpeg2kDecode(nvjpeg2kHandle_t handle,
+                   nvjpeg2kDecodeState_t decode_state,
+                   nvjpeg2kStream_t stream,
+                   nvjpeg2kImage_t *destination,
+                   cudaStream_t stream_cuda)
+   Note: last arg is cudaStream_t — we pass NULL (default stream). */
+typedef nvjpeg2kStatus_t (*PFN_nvjpeg2kDecode)(
+    nvjpeg2kHandle_t handle,
+    nvjpeg2kDecodeState_t decode_state,
+    nvjpeg2kStream_t jpeg_stream,
+    nvjpeg2kImage_t *destination,
+    void *cuda_stream);  /* cudaStream_t, NULL = default stream */
+
+/* ------------------------------------------------------------------ */
+/* CUDA Driver API types and function pointer typedefs                 */
+/* nvcuda.dll is the driver API — always present with any NVIDIA GPU.  */
+/* ------------------------------------------------------------------ */
+
+typedef int   CUdevice;
+typedef void *CUcontext;
+
+typedef CUresult (*PFN_cuInit)(unsigned int Flags);
+typedef CUresult (*PFN_cuDeviceGet)(CUdevice *device, int ordinal);
+typedef CUresult (*PFN_cuDevicePrimaryCtxRetain)(CUcontext *pctx, CUdevice dev);
+typedef CUresult (*PFN_cuDevicePrimaryCtxRelease)(CUdevice dev);
+typedef CUresult (*PFN_cuCtxSetCurrent)(CUcontext ctx);
+typedef CUresult (*PFN_cuMemAlloc_v2)(CUdeviceptr *dptr, size_t bytesize);
+typedef CUresult (*PFN_cuMemFree_v2)(CUdeviceptr dptr);
+typedef CUresult (*PFN_cuMemcpyDtoH_v2)(void *dstHost, CUdeviceptr srcDevice, size_t ByteCount);
+typedef CUresult (*PFN_cuCtxSynchronize)(void);
+
+/* ------------------------------------------------------------------ */
+/* Loader struct — holds all function pointers                         */
+/* ------------------------------------------------------------------ */
+
+typedef struct NVJPEG2KFunctions {
+    /* nvjpeg2k_0.dll */
+    PFN_nvjpeg2kCreateSimple                   CreateSimple;
+    PFN_nvjpeg2kDestroy                        Destroy;
+    PFN_nvjpeg2kDecodeStateCreate              DecodeStateCreate;
+    PFN_nvjpeg2kDecodeStateDestroy             DecodeStateDestroy;
+    PFN_nvjpeg2kStreamCreate                   StreamCreate;
+    PFN_nvjpeg2kStreamDestroy                  StreamDestroy;
+    PFN_nvjpeg2kStreamParse                    StreamParse;
+    PFN_nvjpeg2kStreamGetImageInfo             StreamGetImageInfo;
+    PFN_nvjpeg2kStreamGetImageComponentInfo    StreamGetImageComponentInfo;
+    PFN_nvjpeg2kDecode                         Decode;
+    /* nvcuda.dll (driver API) */
+    PFN_cuInit                                 Init;
+    PFN_cuDeviceGet                            DeviceGet;
+    PFN_cuDevicePrimaryCtxRetain               PrimaryCtxRetain;
+    PFN_cuDevicePrimaryCtxRelease              PrimaryCtxRelease;
+    PFN_cuCtxSetCurrent                        CtxSetCurrent;
+    PFN_cuMemAlloc_v2                          MemAlloc;
+    PFN_cuMemFree_v2                           MemFree;
+    PFN_cuMemcpyDtoH_v2                        MemcpyDtoH;
+    PFN_cuCtxSynchronize                       CtxSynchronize;
+} NVJPEG2KFunctions;
+
+#endif /* AVCODEC_NVJPEG2K_LOADER_H */
diff --git a/libavcodec/nvjpeg2kdec.c b/libavcodec/nvjpeg2kdec.c
new file mode 100644
index 0000000..ed4c79e
--- /dev/null
+++ b/libavcodec/nvjpeg2kdec.c
@@ -0,0 +1,720 @@
+/*
+ * JPEG 2000 decoder using NVIDIA nvJPEG2000 GPU library (dynamic loading)
+ *
+ * Copyright (c) 2024-2026 mpv AC-4 Edition contributors
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config.h"
+
+#ifdef _WIN32
+
+#include <windows.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/pixdesc.h"
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "decode.h"
+#include "nvjpeg2k_loader.h"
+
+#define MAX_COMPONENTS 4
+
+typedef struct NVJPEG2KContext {
+    AVClass              *av_class;
+
+    /* DLL handles */
+    HMODULE               nvjpeg2k_dll;
+    HMODULE               nvcuda_dll;
+
+    /* Function pointers */
+    NVJPEG2KFunctions     fn;
+
+    /* CUDA context & device */
+    CUdevice              cuda_dev;
+    CUcontext             cuda_ctx;
+
+    /* nvJPEG2000 state */
+    nvjpeg2kHandle_t      handle;
+    nvjpeg2kDecodeState_t decode_state;
+    nvjpeg2kStream_t      jpeg_stream;
+
+    /* Device GPU VRAM buffers for each component */
+    CUdeviceptr           dev_buf[MAX_COMPONENTS];
+    size_t                dev_buf_size[MAX_COMPONENTS];
+    size_t                dev_pitch[MAX_COMPONENTS];
+
+    /* Host staging buffers for CPU packing */
+    void                 *host_buf[MAX_COMPONENTS];
+    size_t                host_buf_size[MAX_COMPONENTS];
+
+    /* Last decoded image geometry */
+    uint32_t              buf_width[MAX_COMPONENTS];
+    uint32_t              buf_height[MAX_COMPONENTS];
+    uint32_t              num_components;
+    uint32_t              image_width;
+    uint32_t              image_height;
+
+    /* Container pixel format hint at init */
+    enum AVPixelFormat    initial_pix_fmt;
+} NVJPEG2KContext;
+
+static int load_sym(AVCodecContext *avctx, HMODULE dll,
+                    const char *dll_name, const char *fn_name,
+                    void **out)
+{
+    *out = (void *)GetProcAddress(dll, fn_name);
+    if (!*out) {
+        av_log(avctx, AV_LOG_WARNING,
+               "nvjpeg2k: symbol %s not found in %s\n", fn_name, dll_name);
+        return AVERROR(ENOSYS);
+    }
+    return 0;
+}
+
+#define LOAD_SYM(dll, dll_name, field, sym) \
+    do { \
+        void *_p; \
+        if (load_sym(avctx, dll, dll_name, sym, &_p) < 0) return AVERROR(ENOSYS); \
+        ctx->fn.field = (void *)_p; \
+    } while (0)
+
+static void free_buffers(NVJPEG2KContext *ctx)
+{
+    if (ctx->cuda_ctx && ctx->fn.CtxSetCurrent)
+        ctx->fn.CtxSetCurrent(ctx->cuda_ctx);
+
+    for (int i = 0; i < MAX_COMPONENTS; i++) {
+        if (ctx->dev_buf[i]) {
+            if (ctx->fn.MemFree)
+                ctx->fn.MemFree(ctx->dev_buf[i]);
+            ctx->dev_buf[i] = 0;
+            ctx->dev_buf_size[i] = 0;
+        }
+        if (ctx->host_buf[i]) {
+            av_freep(&ctx->host_buf[i]);
+            ctx->host_buf_size[i] = 0;
+        }
+    }
+}
+
+static av_cold int nvjpeg2k_decode_init(AVCodecContext *avctx)
+{
+    NVJPEG2KContext *ctx = avctx->priv_data;
+    nvjpeg2kStatus_t st;
+    CUresult cr;
+
+    ctx->initial_pix_fmt = avctx->pix_fmt;
+
+    /* --- Load nvjpeg2k_0.dll --- */
+    ctx->nvjpeg2k_dll = LoadLibraryW(L"nvjpeg2k_0.dll");
+    if (!ctx->nvjpeg2k_dll) {
+        av_log(avctx, AV_LOG_INFO,
+               "nvjpeg2k: nvjpeg2k_0.dll not found — falling back to software decoder\n");
+        return AVERROR_DECODER_NOT_FOUND;
+    }
+
+    /* --- Load nvcuda.dll (CUDA Driver API) --- */
+    ctx->nvcuda_dll = LoadLibraryW(L"nvcuda.dll");
+    if (!ctx->nvcuda_dll) {
+        av_log(avctx, AV_LOG_INFO,
+               "nvjpeg2k: nvcuda.dll not found — falling back to software decoder\n");
+        FreeLibrary(ctx->nvjpeg2k_dll);
+        ctx->nvjpeg2k_dll = NULL;
+        return AVERROR_DECODER_NOT_FOUND;
+    }
+
+    /* Resolve nvJPEG2000 symbols */
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", CreateSimple,
+             "nvjpeg2kCreateSimple");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", Destroy,
+             "nvjpeg2kDestroy");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", DecodeStateCreate,
+             "nvjpeg2kDecodeStateCreate");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", DecodeStateDestroy,
+             "nvjpeg2kDecodeStateDestroy");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", StreamCreate,
+             "nvjpeg2kStreamCreate");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", StreamDestroy,
+             "nvjpeg2kStreamDestroy");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", StreamParse,
+             "nvjpeg2kStreamParse");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", StreamGetImageInfo,
+             "nvjpeg2kStreamGetImageInfo");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", StreamGetImageComponentInfo,
+             "nvjpeg2kStreamGetImageComponentInfo");
+    LOAD_SYM(ctx->nvjpeg2k_dll, "nvjpeg2k_0.dll", Decode,
+             "nvjpeg2kDecode");
+
+    /* Resolve CUDA Driver API symbols */
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", Init,
+             "cuInit");
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", DeviceGet,
+             "cuDeviceGet");
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", PrimaryCtxRetain,
+             "cuDevicePrimaryCtxRetain");
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", PrimaryCtxRelease,
+             "cuDevicePrimaryCtxRelease_v2");
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", CtxSetCurrent,
+             "cuCtxSetCurrent");
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", MemAlloc,
+             "cuMemAlloc_v2");
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", MemFree,
+             "cuMemFree_v2");
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", MemcpyDtoH,
+             "cuMemcpyDtoH_v2");
+    LOAD_SYM(ctx->nvcuda_dll, "nvcuda.dll", CtxSynchronize,
+             "cuCtxSynchronize");
+
+    /* Initialise CUDA Driver & Context */
+    cr = ctx->fn.Init(0);
+    if (cr != CUDA_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: cuInit failed (%d)\n", (int)cr);
+        return AVERROR_EXTERNAL;
+    }
+
+    cr = ctx->fn.DeviceGet(&ctx->cuda_dev, 0);
+    if (cr != CUDA_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: cuDeviceGet failed (%d)\n", (int)cr);
+        return AVERROR_EXTERNAL;
+    }
+
+    cr = ctx->fn.PrimaryCtxRetain(&ctx->cuda_ctx, ctx->cuda_dev);
+    if (cr != CUDA_SUCCESS || !ctx->cuda_ctx) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: cuDevicePrimaryCtxRetain failed (%d)\n", (int)cr);
+        return AVERROR_EXTERNAL;
+    }
+
+    cr = ctx->fn.CtxSetCurrent(ctx->cuda_ctx);
+    if (cr != CUDA_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: cuCtxSetCurrent failed (%d)\n", (int)cr);
+        return AVERROR_EXTERNAL;
+    }
+
+    /* Initialise nvJPEG2000 handles */
+    st = ctx->fn.CreateSimple(&ctx->handle);
+    if (st != NVJPEG2K_STATUS_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: CreateSimple failed (%d)\n", (int)st);
+        return AVERROR_EXTERNAL;
+    }
+
+    st = ctx->fn.DecodeStateCreate(ctx->handle, &ctx->decode_state);
+    if (st != NVJPEG2K_STATUS_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: DecodeStateCreate failed (%d)\n", (int)st);
+        ctx->fn.Destroy(ctx->handle);
+        ctx->handle = NULL;
+        return AVERROR_EXTERNAL;
+    }
+
+    st = ctx->fn.StreamCreate(&ctx->jpeg_stream);
+    if (st != NVJPEG2K_STATUS_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: StreamCreate failed (%d)\n", (int)st);
+        ctx->fn.DecodeStateDestroy(ctx->decode_state);
+        ctx->fn.Destroy(ctx->handle);
+        ctx->handle = NULL;
+        return AVERROR_EXTERNAL;
+    }
+
+    av_log(avctx, AV_LOG_INFO,
+           "nvjpeg2k: GPU JPEG 2000 decoder initialised successfully on NVIDIA device %d\n",
+           ctx->cuda_dev);
+    return 0;
+}
+
+static int ensure_buffers(AVCodecContext *avctx,
+                          NVJPEG2KContext *ctx,
+                          const nvjpeg2kImageInfo_t *info,
+                          const nvjpeg2kImageComponentInfo_t comp_info[],
+                          uint32_t ncomp)
+{
+    ctx->fn.CtxSetCurrent(ctx->cuda_ctx);
+
+    for (uint32_t c = 0; c < ncomp; c++) {
+        uint32_t w = comp_info[c].component_width;
+        uint32_t h = comp_info[c].component_height;
+        size_t pitch = (size_t)w * 2;
+        size_t total = pitch * h;
+
+        if (total > ctx->dev_buf_size[c]) {
+            if (ctx->dev_buf[c]) {
+                ctx->fn.MemFree(ctx->dev_buf[c]);
+                ctx->dev_buf[c] = 0;
+            }
+            CUresult cr = ctx->fn.MemAlloc(&ctx->dev_buf[c], total);
+            if (cr != CUDA_SUCCESS || !ctx->dev_buf[c]) {
+                av_log(avctx, AV_LOG_ERROR,
+                       "nvjpeg2k: cuMemAlloc failed for component %u (size %zu), error %d\n",
+                       c, total, (int)cr);
+                return AVERROR(ENOMEM);
+            }
+            ctx->dev_buf_size[c] = total;
+        }
+
+        if (total > ctx->host_buf_size[c]) {
+            av_freep(&ctx->host_buf[c]);
+            ctx->host_buf[c] = av_malloc(total);
+            if (!ctx->host_buf[c])
+                return AVERROR(ENOMEM);
+            ctx->host_buf_size[c] = total;
+        }
+
+        ctx->dev_pitch[c]  = pitch;
+        ctx->buf_width[c]  = w;
+        ctx->buf_height[c] = h;
+    }
+    return 0;
+}
+
+static enum AVPixelFormat select_pixel_format(AVCodecContext *avctx,
+                                              NVJPEG2KContext *ctx,
+                                              uint32_t ncomp,
+                                              const nvjpeg2kImageComponentInfo_t comp_info[],
+                                              int *plane_map)
+{
+    uint8_t prec = comp_info[0].precision;
+
+    if (ncomp == 1) {
+        plane_map[0] = 0;
+        if (prec <= 8)  return AV_PIX_FMT_GRAY8;
+        if (prec <= 10) return AV_PIX_FMT_GRAY10LE;
+        if (prec <= 12) return AV_PIX_FMT_GRAY12LE;
+        return AV_PIX_FMT_GRAY16LE;
+    }
+
+    if (ncomp == 4) {
+        uint32_t w0 = comp_info[0].component_width;
+        uint32_t h0 = comp_info[0].component_height;
+        uint32_t w1 = comp_info[1].component_width;
+        uint32_t h1 = comp_info[1].component_height;
+
+        if (w1 < w0 || h1 < h0) {
+            /* YUVA 4:2:0 */
+            plane_map[0] = 0;
+            plane_map[1] = 1;
+            plane_map[2] = 2;
+            plane_map[3] = 3;
+            if (prec <= 8)  return AV_PIX_FMT_YUVA420P;
+            if (prec <= 10) return AV_PIX_FMT_YUVA420P10LE;
+            return AV_PIX_FMT_YUVA420P16LE;
+        } else {
+            /* GBRAP (RGBA) */
+            plane_map[0] = 2; /* R -> plane 2 */
+            plane_map[1] = 0; /* G -> plane 0 */
+            plane_map[2] = 1; /* B -> plane 1 */
+            plane_map[3] = 3; /* A -> plane 3 */
+            if (prec <= 8)  return AV_PIX_FMT_GBRAP;
+            if (prec <= 10) return AV_PIX_FMT_GBRAP10LE;
+            if (prec <= 12) return AV_PIX_FMT_GBRAP12LE;
+            return AV_PIX_FMT_GBRAP16LE;
+        }
+    }
+
+    if (ncomp == 3) {
+        uint32_t w0 = comp_info[0].component_width;
+        uint32_t h0 = comp_info[0].component_height;
+        uint32_t w1 = comp_info[1].component_width;
+        uint32_t h1 = comp_info[1].component_height;
+        uint32_t w2 = comp_info[2].component_width;
+        uint32_t h2 = comp_info[2].component_height;
+
+        /* DCI XYZ Check */
+        if (prec == 12 && w0 == w1 && h0 == h1 &&
+            (avctx->color_primaries == AVCOL_PRI_SMPTE428 ||
+             avctx->pix_fmt == AV_PIX_FMT_XYZ12LE)) {
+            plane_map[0] = 0;
+            plane_map[1] = 1;
+            plane_map[2] = 2;
+            return AV_PIX_FMT_XYZ12LE;
+        }
+
+        /* Subsampled Chroma: YUV planar */
+        if (w1 < w0 || h1 < h0 || w2 < w0 || h2 < h0) {
+            plane_map[0] = 0; /* Y -> plane 0 */
+            plane_map[1] = 1; /* U -> plane 1 */
+            plane_map[2] = 2; /* V -> plane 2 */
+
+            if (w1 == (w0 + 1) / 2 && h1 == (h0 + 1) / 2) {
+                /* 4:2:0 */
+                if (prec <= 8)  return AV_PIX_FMT_YUV420P;
+                if (prec <= 10) return AV_PIX_FMT_YUV420P10LE;
+                if (prec <= 12) return AV_PIX_FMT_YUV420P12LE;
+                return AV_PIX_FMT_YUV420P16LE;
+            } else if (w1 == (w0 + 1) / 2 && h1 == h0) {
+                /* 4:2:2 */
+                if (prec <= 8)  return AV_PIX_FMT_YUV422P;
+                if (prec <= 10) return AV_PIX_FMT_YUV422P10LE;
+                if (prec <= 12) return AV_PIX_FMT_YUV422P12LE;
+                return AV_PIX_FMT_YUV422P16LE;
+            } else if (w1 == w0 && h1 == (h0 + 1) / 2) {
+                /* 4:4:0 */
+                if (prec <= 8)  return AV_PIX_FMT_YUV440P;
+                if (prec <= 10) return AV_PIX_FMT_YUV440P10LE;
+                return AV_PIX_FMT_YUV440P12LE;
+            } else {
+                /* Default subsampled fallback to 4:2:0 */
+                if (prec <= 8)  return AV_PIX_FMT_YUV420P;
+                if (prec <= 10) return AV_PIX_FMT_YUV420P10LE;
+                if (prec <= 12) return AV_PIX_FMT_YUV420P12LE;
+                return AV_PIX_FMT_YUV420P16LE;
+            }
+        }
+
+        /* 3 components, 1:1:1: Check YUV 4:4:4 vs RGB */
+        int is_yuv444 = 0;
+        if (avctx->colorspace == AVCOL_SPC_BT709 ||
+            avctx->colorspace == AVCOL_SPC_BT470BG ||
+            avctx->colorspace == AVCOL_SPC_SMPTE170M ||
+            avctx->colorspace == AVCOL_SPC_SMPTE240M ||
+            avctx->colorspace == AVCOL_SPC_BT2020_NCL ||
+            avctx->colorspace == AVCOL_SPC_BT2020_CL) {
+            is_yuv444 = 1;
+        } else if (avctx->color_range == AVCOL_RANGE_MPEG) {
+            is_yuv444 = 1;
+        } else if (ctx && (ctx->initial_pix_fmt == AV_PIX_FMT_YUV444P ||
+                           ctx->initial_pix_fmt == AV_PIX_FMT_YUV444P10LE ||
+                           ctx->initial_pix_fmt == AV_PIX_FMT_YUV444P12LE ||
+                           ctx->initial_pix_fmt == AV_PIX_FMT_YUV444P16LE)) {
+            is_yuv444 = 1;
+        } else if (avctx->pix_fmt == AV_PIX_FMT_YUV444P ||
+                   avctx->pix_fmt == AV_PIX_FMT_YUV444P10LE ||
+                   avctx->pix_fmt == AV_PIX_FMT_YUV444P12LE ||
+                   avctx->pix_fmt == AV_PIX_FMT_YUV444P16LE) {
+            is_yuv444 = 1;
+        }
+
+        if (is_yuv444) {
+            plane_map[0] = 0;
+            plane_map[1] = 1;
+            plane_map[2] = 2;
+            if (prec <= 8)  return AV_PIX_FMT_YUV444P;
+            if (prec <= 10) return AV_PIX_FMT_YUV444P10LE;
+            if (prec <= 12) return AV_PIX_FMT_YUV444P12LE;
+            return AV_PIX_FMT_YUV444P16LE;
+        }
+
+        /* Standard RGB planar (GBRP) */
+        plane_map[0] = 2; /* R -> plane 2 */
+        plane_map[1] = 0; /* G -> plane 0 */
+        plane_map[2] = 1; /* B -> plane 1 */
+        if (prec <= 8)  return AV_PIX_FMT_GBRP;
+        if (prec <= 10) return AV_PIX_FMT_GBRP10LE;
+        if (prec <= 12) return AV_PIX_FMT_GBRP12LE;
+        return AV_PIX_FMT_GBRP16LE;
+    }
+
+    /* Fallback */
+    plane_map[0] = 2;
+    plane_map[1] = 0;
+    plane_map[2] = 1;
+    return AV_PIX_FMT_GBRP;
+}
+
+static int nvjpeg2k_decode_frame(AVCodecContext *avctx, AVFrame *frame,
+                                 int *got_frame, AVPacket *avpkt)
+{
+    NVJPEG2KContext    *ctx = avctx->priv_data;
+    nvjpeg2kStatus_t   st;
+    nvjpeg2kImageInfo_t img_info;
+    nvjpeg2kImageComponentInfo_t comp_info[MAX_COMPONENTS];
+    nvjpeg2kImage_t    decoded_img;
+    int                ret = 0;
+    uint32_t           ncomp;
+
+    if (!avpkt->size)
+        return 0;
+
+    /* Bind CUDA context to current decoding thread */
+    ctx->fn.CtxSetCurrent(ctx->cuda_ctx);
+
+    /* --- 1. Parse bitstream --- */
+    st = ctx->fn.StreamParse(ctx->handle,
+                             avpkt->data, (size_t)avpkt->size,
+                             0, 0,
+                             ctx->jpeg_stream);
+    if (st != NVJPEG2K_STATUS_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: StreamParse failed (%d)\n", (int)st);
+        return AVERROR_INVALIDDATA;
+    }
+
+    /* --- 2. Query image metadata --- */
+    st = ctx->fn.StreamGetImageInfo(ctx->jpeg_stream, &img_info);
+    if (st != NVJPEG2K_STATUS_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: StreamGetImageInfo failed (%d)\n", (int)st);
+        return AVERROR_INVALIDDATA;
+    }
+
+    ncomp = img_info.num_components;
+    if (ncomp > MAX_COMPONENTS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: too many components (%u > %d)\n",
+               ncomp, MAX_COMPONENTS);
+        return AVERROR_INVALIDDATA;
+    }
+
+    for (uint32_t c = 0; c < ncomp; c++) {
+        st = ctx->fn.StreamGetImageComponentInfo(ctx->jpeg_stream, &comp_info[c], c);
+        if (st != NVJPEG2K_STATUS_SUCCESS) {
+            av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: StreamGetImageComponentInfo[%u] failed (%d)\n",
+                   c, (int)st);
+            return AVERROR_INVALIDDATA;
+        }
+    }
+
+    /* --- 3. Determine pixel format & component plane mapping --- */
+    int plane_map[MAX_COMPONENTS] = {0, 1, 2, 3};
+    enum AVPixelFormat pix_fmt = select_pixel_format(avctx, ctx, ncomp, comp_info, plane_map);
+
+    /* --- 4. Allocate GPU VRAM buffers & CPU staging buffers --- */
+    ret = ensure_buffers(avctx, ctx, &img_info, comp_info, ncomp);
+    if (ret < 0)
+        return ret;
+
+    /* --- 5. Setup nvjpeg2kImage_t pointing to GPU device memory --- */
+    void  *pixel_data[MAX_COMPONENTS];
+    size_t pitch_arr[MAX_COMPONENTS];
+    for (uint32_t c = 0; c < ncomp; c++) {
+        pixel_data[c] = (void *)(uintptr_t)ctx->dev_buf[c];
+        pitch_arr[c]  = ctx->dev_pitch[c];
+    }
+    decoded_img.pixel_data     = pixel_data;
+    decoded_img.pitch_in_bytes = pitch_arr;
+    decoded_img.pixel_type     = NVJPEG2K_UINT16;
+    decoded_img.num_components = ncomp;
+
+    /* --- 6. GPU Decode --- */
+    st = ctx->fn.Decode(ctx->handle,
+                        ctx->decode_state,
+                        ctx->jpeg_stream,
+                        &decoded_img,
+                        NULL);
+    if (st != NVJPEG2K_STATUS_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "nvjpeg2k: Decode failed (%d)\n", (int)st);
+        return AVERROR_EXTERNAL;
+    }
+
+    ctx->fn.CtxSynchronize();
+
+    /* Copy decoded planes from GPU VRAM to CPU staging buffers */
+    for (uint32_t c = 0; c < ncomp; c++) {
+        size_t total = ctx->dev_pitch[c] * comp_info[c].component_height;
+        ctx->fn.MemcpyDtoH(ctx->host_buf[c], ctx->dev_buf[c], total);
+    }
+
+    /* --- 7. Allocate AVFrame --- */
+    ret = ff_set_dimensions(avctx, (int)img_info.image_width, (int)img_info.image_height);
+    if (ret < 0)
+        return ret;
+    avctx->pix_fmt = pix_fmt;
+
+    ret = ff_get_buffer(avctx, frame, 0);
+    if (ret < 0)
+        return ret;
+
+    /* --- 8. Pack into AVFrame --- */
+    if (pix_fmt == AV_PIX_FMT_XYZ12LE) {
+        uint32_t W = img_info.image_width;
+        uint32_t H = img_info.image_height;
+        uint8_t *dst = frame->data[0];
+        int dstride  = frame->linesize[0];
+
+        const uint16_t *src_x = (const uint16_t *)ctx->host_buf[0];
+        const uint16_t *src_y = (const uint16_t *)ctx->host_buf[1];
+        const uint16_t *src_z = (const uint16_t *)ctx->host_buf[2];
+        size_t sx_pitch = ctx->dev_pitch[0] / 2;
+        size_t sy_pitch = ctx->dev_pitch[1] / 2;
+        size_t sz_pitch = ctx->dev_pitch[2] / 2;
+
+        for (uint32_t y = 0; y < H; y++) {
+            uint16_t *d = (uint16_t *)(dst + (size_t)y * dstride);
+            const uint16_t *rx = src_x + (size_t)y * sx_pitch;
+            const uint16_t *ry = src_y + (size_t)y * sy_pitch;
+            const uint16_t *rz = src_z + (size_t)y * sz_pitch;
+            for (uint32_t x = 0; x < W; x++) {
+                d[3*x + 0] = (uint16_t)(rx[x] << 4);
+                d[3*x + 1] = (uint16_t)(ry[x] << 4);
+                d[3*x + 2] = (uint16_t)(rz[x] << 4);
+            }
+        }
+        frame->color_primaries = AVCOL_PRI_SMPTE428;
+        frame->color_trc       = AVCOL_TRC_SMPTE428;
+        frame->colorspace      = AVCOL_SPC_RGB;
+    } else {
+        const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(pix_fmt);
+        int bytes_per_sample = (desc && desc->comp[0].depth > 8) ? 2 : 1;
+        int target_depth     = desc ? desc->comp[0].depth : 8;
+
+        for (uint32_t c = 0; c < ncomp && c < MAX_COMPONENTS; c++) {
+            int p = plane_map[c];
+            uint32_t W = comp_info[c].component_width;
+            uint32_t H = comp_info[c].component_height;
+            uint8_t *dst = frame->data[p];
+            int dstride  = frame->linesize[p];
+            const uint16_t *src = (const uint16_t *)ctx->host_buf[c];
+            size_t spitch = ctx->dev_pitch[c] / 2;
+            int src_prec  = (int)comp_info[c].precision;
+            int shift     = target_depth - src_prec;
+
+            if (bytes_per_sample == 1) {
+                if (shift < 0) {
+                    int rshift = -shift;
+                    for (uint32_t y = 0; y < H; y++) {
+                        uint8_t *d = dst + (size_t)y * dstride;
+                        const uint16_t *s = src + (size_t)y * spitch;
+                        for (uint32_t x = 0; x < W; x++)
+                            d[x] = (uint8_t)(s[x] >> rshift);
+                    }
+                } else {
+                    for (uint32_t y = 0; y < H; y++) {
+                        uint8_t *d = dst + (size_t)y * dstride;
+                        const uint16_t *s = src + (size_t)y * spitch;
+                        for (uint32_t x = 0; x < W; x++)
+                            d[x] = (uint8_t)s[x];
+                    }
+                }
+            } else {
+                if (shift > 0) {
+                    for (uint32_t y = 0; y < H; y++) {
+                        uint16_t *d = (uint16_t *)(dst + (size_t)y * dstride);
+                        const uint16_t *s = src + (size_t)y * spitch;
+                        for (uint32_t x = 0; x < W; x++)
+                            d[x] = (uint16_t)(s[x] << shift);
+                    }
+                } else if (shift < 0) {
+                    int rshift = -shift;
+                    for (uint32_t y = 0; y < H; y++) {
+                        uint16_t *d = (uint16_t *)(dst + (size_t)y * dstride);
+                        const uint16_t *s = src + (size_t)y * spitch;
+                        for (uint32_t x = 0; x < W; x++)
+                            d[x] = (uint16_t)(s[x] >> rshift);
+                    }
+                } else {
+                    for (uint32_t y = 0; y < H; y++) {
+                        uint16_t *d = (uint16_t *)(dst + (size_t)y * dstride);
+                        const uint16_t *s = src + (size_t)y * spitch;
+                        for (uint32_t x = 0; x < W; x++)
+                            d[x] = s[x];
+                    }
+                }
+            }
+        }
+
+        if (desc && (desc->flags & AV_PIX_FMT_FLAG_RGB)) {
+            frame->color_primaries = avctx->color_primaries;
+            frame->color_trc       = avctx->color_trc;
+            frame->colorspace      = AVCOL_SPC_RGB;
+            frame->color_range     = AVCOL_RANGE_JPEG;
+        }
+    }
+
+    frame->flags |= AV_FRAME_FLAG_KEY;
+    frame->pict_type = AV_PICTURE_TYPE_I;
+    frame->pts = avpkt->pts;
+    frame->pkt_dts = avpkt->dts;
+    *got_frame = 1;
+    return avpkt->size;
+}
+
+static av_cold int nvjpeg2k_decode_close(AVCodecContext *avctx)
+{
+    NVJPEG2KContext *ctx = avctx->priv_data;
+
+    free_buffers(ctx);
+
+    if (ctx->jpeg_stream && ctx->fn.StreamDestroy) {
+        ctx->fn.StreamDestroy(ctx->jpeg_stream);
+        ctx->jpeg_stream = NULL;
+    }
+    if (ctx->decode_state && ctx->fn.DecodeStateDestroy) {
+        ctx->fn.DecodeStateDestroy(ctx->decode_state);
+        ctx->decode_state = NULL;
+    }
+    if (ctx->handle && ctx->fn.Destroy) {
+        ctx->fn.Destroy(ctx->handle);
+        ctx->handle = NULL;
+    }
+    if (ctx->cuda_ctx && ctx->fn.PrimaryCtxRelease) {
+        ctx->fn.PrimaryCtxRelease(ctx->cuda_dev);
+        ctx->cuda_ctx = NULL;
+    }
+
+    if (ctx->nvcuda_dll) {
+        FreeLibrary(ctx->nvcuda_dll);
+        ctx->nvcuda_dll = NULL;
+    }
+    if (ctx->nvjpeg2k_dll) {
+        FreeLibrary(ctx->nvjpeg2k_dll);
+        ctx->nvjpeg2k_dll = NULL;
+    }
+
+    return 0;
+}
